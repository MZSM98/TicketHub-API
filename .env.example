# Copia este archivo a .env y cambia los valores. Nunca subas .env al repo.
# Todos los valores de aquí son de ejemplo para desarrollo local.

# --- General ---
NODE_ENV=development
# Puerto del servidor mock (Prism) en tu máquina: docker compose --profile mock up mock
MOCK_HOST_PORT=4010
# Puerto del API Gateway en tu máquina (el único servicio de la API expuesto al host).
GATEWAY_HOST_PORT=8080
# URL pública del gateway, para armar posterUrl y qrImageUrl.
PUBLIC_BASE_URL=http://localhost:8080/api/v1
PUBLIC_HOSTS_ALLOWED=
GATEWAY_FORWARD_SECRET=change-me-gateway-forward-secret-32-chars

# --- MySQL (una instancia, un esquema y un usuario por servicio) ---
MYSQL_ROOT_PASSWORD=change-me-root
# Puerto de MySQL en tu máquina, solo en 127.0.0.1 (para Workbench o DBeaver).
MYSQL_HOST_PORT=3306
MYSQL_HOST=mysql
MYSQL_PORT=3306

IDENTITY_DB_NAME=tickethub_identity
IDENTITY_DB_USER=identity_svc
IDENTITY_DB_PASSWORD=change-me-identity

CATALOG_DB_NAME=tickethub_catalog
CATALOG_DB_USER=catalog_svc
CATALOG_DB_PASSWORD=change-me-catalog

INVENTORY_DB_NAME=tickethub_inventory
INVENTORY_DB_USER=inventory_svc
INVENTORY_DB_PASSWORD=change-me-inventory

PURCHASE_DB_NAME=tickethub_purchase
PURCHASE_DB_USER=purchase_svc
PURCHASE_DB_PASSWORD=change-me-purchase

TICKET_DB_NAME=tickethub_ticket
TICKET_DB_USER=ticket_svc
TICKET_DB_PASSWORD=change-me-ticket

# --- Autenticación (IdentityService firma, el gateway y los servicios verifican) ---
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
# Segundos de vida del access token.
JWT_EXPIRES_IN=3600
REFRESH_TOKEN_TTL_DAYS=7
# Costo de bcrypt para los hashes de contraseñas.
BCRYPT_ROUNDS=10
# Secreto compartido para /internal/** (header X-Internal-Token).
INTERNAL_TOKEN=change-me-internal-token

# --- Primer administrador (npm run create-admin en identity-service) ---
# Solo se usan al ejecutar el script. Puedes dejarlos vacíos aquí y pasarlos con -e.
ADMIN_NAME="Administrador TicketHub"
ADMIN_EMAIL=admin@tickethub.local
ADMIN_PASSWORD=change-me-admin-password

# --- Inventario ---
RESERVATION_TTL_MINUTES=10
MAX_TICKETS_PER_RESERVATION=10
RESERVATION_SWEEP_SECONDS=60

# --- Pagos ---
PAYMENT_PROVIDER=stripe
PAYMENT_MAX_ATTEMPTS=3
# Llave secreta de Stripe en modo prueba (empieza con sk_test_).
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_API_BASE=https://api.stripe.com
STRIPE_TIMEOUT_MS=10000
# Cada cuántos segundos se reintenta la emisión de boletos pendiente.
TICKET_RETRY_SECONDS=30

# --- Boletos ---
# Firma HS256 del token que va en el QR.
TICKET_SIGNING_SECRET=change-me-ticket-signing-secret

# --- MinIO (archivos compatibles con S3: pósters y QR) ---
MINIO_ROOT_USER=tickethub
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_POSTERS=posters
MINIO_BUCKET_QR=tickets-qr
# Usuarios de MinIO por servicio, cada uno limitado a su bucket (los crea minio-init).
CATALOG_MINIO_ACCESS_KEY=catalog-svc
CATALOG_MINIO_SECRET_KEY=change-me-catalog-minio
TICKET_MINIO_ACCESS_KEY=ticket-svc
TICKET_MINIO_SECRET_KEY=change-me-ticket-minio
# Consola web de MinIO en tu máquina.
MINIO_CONSOLE_HOST_PORT=9001

# --- Correo (SMTP) ---
# Desarrollo: Mailpit (buzón falso, sin usuario ni contraseña).
# Producción/demo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=tu-cuenta@gmail.com y SMTP_PASS=la contraseña de aplicación de 16 letras
# (https://myaccount.google.com/apppasswords). Nunca la contraseña normal de la cuenta.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TicketHub <no-reply@tickethub.local>"
# Buzón web de Mailpit en tu máquina.
MAILPIT_UI_HOST_PORT=8025
PAYMENT_SWEEP_SECONDS=60
PAYMENT_RECONCILE_AFTER_SECONDS=60
PAYMENT_CLAIM_SECONDS=
TICKET_RETRY_BACKOFF_SECONDS=30
TICKET_RETRY_MAX_SECONDS=3600
TICKET_RETRY_BATCH=50
TICKET_RETRY_MAX_ATTEMPTS=50
