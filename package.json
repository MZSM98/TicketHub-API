{
  "name": "tickethub-api",
  "version": "0.1.0",
  "private": true,
  "description": "TicketHub API: API Gateway y servicios Identity, Catalog, Inventory, Purchase y Ticket",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock:build": "node scripts/build-mock-spec.js",
    "mock:check": "node scripts/build-mock-spec.js && git diff --exit-code -- mock/",
    "mock": "npm run mock:build && prism mock -p 4010 mock/tickethub.openapi.json",
    "test": "sh scripts/test.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.71.1",
    "@stoplight/prism-cli": "5.16.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "decode-uri-component": "0.5.1"
  }
}
